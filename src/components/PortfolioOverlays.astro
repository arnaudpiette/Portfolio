---
// Assemble les deux contenus affichés dans les dialogues du portfolio.
import ContactForm from './ContactForm.astro';
import SkillsShowcase from './SkillsShowcase.astro';

// Décrit les données transmises aux listes de compétences des overlays.
interface SkillLogo {
  src: string;
  label: string;
  className?: string;
}

interface SkillGroup {
  title: string;
  logos: SkillLogo[];
}

interface Props {
  theme: 'light' | 'dark';
  logos?: SkillLogo[];
  groups?: SkillGroup[];
}

// Lit le thème et les compétences propres au portfolio courant.
const { theme, logos = [], groups = [] } = Astro.props;
---

<!-- Dialogue modal qui rassemble la présentation et les compétences. -->
<dialog id="portfolio-skills-dialog" class:list={['portfolio-overlay', `overlay-${theme}`]} aria-labelledby="portfolio-skills-title">
  <div class="overlay-panel">
    <button class="overlay-close" type="button" data-overlay-close aria-label="Fermer la fenêtre">×</button>
    <h2 id="portfolio-skills-title">À propos &amp; Compétences</h2>
    <section class="about-section" aria-labelledby="about-title">
      <h3 id="about-title">À propos</h3>
      <p class="about-intro"><strong>Je suis Arnaud Piette, directeur de création, directeur artistique et développeur web.</strong></p>
      <p>Mon parcours vient d’abord de la création : direction artistique, identité de marque, publicité, illustration, webdesign et conception d’expériences digitales. Au fil des projets, j’ai voulu aller plus loin que la conception graphique et être capable de comprendre et construire moi-même les interfaces que j’imaginais.</p>
      <p>J’ai donc complété mon expérience créative par une formation de développeur web chez OpenClassrooms, avec des projets couvrant l’intégration responsive, JavaScript, React, Node.js, Express, les API REST, les bases de données, l’authentification, la sécurité, le SEO, les performances et l’accessibilité.</p>
      <p>Cette double compétence me permet aujourd’hui d’aborder un projet de manière globale : <strong>comprendre le besoin, concevoir son identité et son expérience utilisateur, puis participer concrètement à son développement.</strong></p>
      <p>Des projets comme <strong>Kasa</strong>, <strong>Mon Vieux Grimoire</strong> ou <strong>Nina Carducci</strong> m’ont permis de consolider mes compétences techniques, tandis que mes expériences en direction artistique m’ont appris à défendre une intention, construire un système visuel cohérent et penser l’expérience du point de vue de l’utilisateur.</p>
      <p>Je développe également <strong>Noon</strong>, un projet personnel d’assistant IA, qui me permet d’aller plus loin dans la conception produit, l’interface, l’architecture logicielle et l’expérimentation autour de l’intelligence artificielle.</p>
      <p>Mon approche reste la même quel que soit le projet : <strong>chercher une solution claire, cohérente, utile et soignée jusque dans les détails.</strong></p>
      <p>Aujourd’hui, je souhaite mettre cette complémentarité <strong>création + développement</strong> au service de projets numériques où design et technique ne sont pas traités comme deux disciplines séparées.</p>
    </section>
    <section class="overlay-skills" aria-labelledby="portfolio-skills-section-title">
      <h3 id="portfolio-skills-section-title">Compétences</h3>
      <SkillsShowcase theme={theme} logos={logos} groups={groups} />
    </section>
  </div>
</dialog>

<!-- Dialogue modal qui contient le formulaire de contact. -->
<dialog id="portfolio-contact-dialog" class:list={['portfolio-overlay', `overlay-${theme}`]} aria-labelledby="portfolio-contact-title">
  <div class="overlay-panel contact-panel">
    <button class="overlay-close" type="button" data-overlay-close aria-label="Fermer la fenêtre">×</button>
    <h2 id="portfolio-contact-title" class="sr-only">Contact</h2>
    <ContactForm theme={theme} sectionId="portfolio-contact-form" showFooter={false} />
  </div>
</dialog>

<script>
  // Relie les boutons d'ouverture et de fermeture aux dialogues natifs.
  const setupPortfolioOverlays = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-overlay-open]').forEach((button) => {
      if (button.dataset.overlayReady) return;
      button.dataset.overlayReady = 'true';
      button.addEventListener('click', () => {
        const dialog = document.getElementById(button.dataset.overlayOpen ?? '');
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    });

    document.querySelectorAll<HTMLDialogElement>('.portfolio-overlay').forEach((dialog) => {
      if (dialog.dataset.overlayReady) return;
      dialog.dataset.overlayReady = 'true';
      dialog.querySelector<HTMLButtonElement>('[data-overlay-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  };

  setupPortfolioOverlays();
  document.addEventListener('astro:page-load', setupPortfolioOverlays);
</script>

<style>
  /* Dimensionnement, thèmes et interactions des fenêtres modales. */
  .portfolio-overlay {
    width: min(1180px, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    padding: 0;
    overflow: auto;
    border: 0;
    border-radius: 32px;
    background: transparent;
    color: var(--overlay-text);
  }
  .portfolio-overlay::backdrop { background: rgba(3, 9, 8, .8); backdrop-filter: blur(6px); }
  .overlay-light { --overlay-background: #fff; --overlay-text: #0000FF; --overlay-accent: #ff8a5b; --overlay-border: rgba(0, 0, 255, .12); }
  .overlay-dark { --overlay-background: #07100d; --overlay-text: #f5f5f5; --overlay-accent: #9af57f; --overlay-border: #213d32; }
  .overlay-panel { position: relative; min-height: 220px; padding: clamp(1.25rem, 3vw, 2.5rem); border: 1px solid var(--overlay-border); border-radius: 32px; background: var(--overlay-background); }
  .overlay-panel > h2 { margin: 0; font-size: clamp(1.7rem, 4vw, 3.5rem); line-height: 1; }
  .about-section { width: min(100%, 780px); margin: clamp(1.75rem, 4vw, 3rem) 0 0; }
  .about-section h3, .overlay-skills > h3 { margin: 0 0 1rem; color: var(--overlay-accent); font-size: .78rem; line-height: 1; letter-spacing: .18em; text-transform: uppercase; }
  .about-section p { margin: 0 0 1rem; color: color-mix(in srgb, var(--overlay-text) 82%, transparent); font-size: clamp(.94rem, 1.5vw, 1.08rem); line-height: 1.62; }
  .about-section .about-intro { color: var(--overlay-text); font-size: clamp(1.08rem, 2vw, 1.35rem); line-height: 1.42; }
  .overlay-skills { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .overlay-close { position: sticky; z-index: 5; top: 0; float: right; display: grid; width: 46px; height: 46px; padding: 0; place-items: center; border: 1px solid currentColor; border-radius: 50%; background: var(--overlay-background); color: var(--overlay-accent); font: 300 2rem/1 Arial, sans-serif; cursor: pointer; }
  .overlay-close:hover { background: var(--overlay-accent); color: var(--overlay-background); }
  .overlay-close:focus-visible { outline: 3px solid var(--overlay-accent); outline-offset: 3px; }
  .contact-panel { padding: 0; overflow: hidden; }
  .contact-panel .overlay-close { top: 1.25rem; right: 1.25rem; margin: 1.25rem 1.25rem 0 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 600px) {
    .portfolio-overlay { width: calc(100% - 1rem); max-height: calc(100dvh - 1rem); border-radius: 22px; }
    .overlay-panel { padding: 1rem; border-radius: 22px; }
    .about-section { margin-top: 1.5rem; }
    .contact-panel { padding: 0; }
  }
</style>
