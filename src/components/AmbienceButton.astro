---
const { src = '/sounds/ambience.mp3' } = Astro.props;
---

<style>
  #ambience-btn {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    background: rgba(11,11,11,0.85);
    color: #fff;
    font-size: 1.2rem;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  }
  #ambience-btn[aria-pressed="true"] { background: #ff6b3d; color: #000; }
</style>

<button
  id="ambience-btn"
  data-audio-src={src}
  aria-label="Activer le son d’ambiance"
  aria-pressed="false"
  title="Activer le son d’ambiance"
>▶︎</button>

<script>
  const btn = document.getElementById('ambience-btn');
  const audio = new Audio(btn?.dataset.audioSrc ?? '');
  audio.loop = true;

  btn?.addEventListener('click', async () => {
    try {
      if (audio.paused) {
        await audio.play();
        btn.textContent = '⏸';
        btn.setAttribute('aria-pressed','true');
        btn.setAttribute('aria-label', 'Désactiver le son d’ambiance');
        btn.setAttribute('title', 'Désactiver le son d’ambiance');
      } else {
        audio.pause();
        btn.textContent = '▶︎';
        btn.setAttribute('aria-pressed','false');
        btn.setAttribute('aria-label', 'Activer le son d’ambiance');
        btn.setAttribute('title', 'Activer le son d’ambiance');
      }
    } catch (e) {
      console.error('Audio playback failed', e);
    }
  });
</script>
