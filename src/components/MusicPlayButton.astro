---
// Décrit le thème et l'option de position fixe du lecteur musical.
interface Props {
  theme: 'creative' | 'dev';
  fixed?: boolean;
}

// Sélectionne le fichier audio correspondant au portfolio affiché.
const { theme, fixed = false } = Astro.props;
const audioSrc = theme === 'dev'
  ? '/sounds/Hot Butter Popcorn.mp3'
  : '/sounds/creative-theme.mp3';
---

<!-- Contrôle persistant pendant les transitions Astro pour préserver la lecture audio. -->
<div class:list={['music-player-control', `is-${theme}`, { 'is-fixed': fixed }]} transition:persist={`portfolio-music-${theme}`}>
  <button class="music-play-button" data-audio-src={audioSrc} type="button" aria-label="Lire la musique" aria-pressed="false">
    <svg class="sound-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path class="sound-speaker" d="M4 10h4l5-4v12l-5-4H4z" />
      <path class="sound-wave sound-wave-near" d="M16 10.5a4 4 0 0 1 0 3" />
      <path class="sound-wave sound-wave-far" d="M18.75 8a7.25 7.25 0 0 1 0 8" />
    </svg>
  </button>
</div>

<script>
  // Partage une instance audio globale et synchronise son état avec le bouton.
  const setupMusicPlayer = () => {
    const win = window as typeof window & {
      portfolioAudio?: HTMLAudioElement;
      portfolioDevAudioFocusReady?: boolean;
    };
    const button = document.querySelector<HTMLButtonElement>('.music-play-button');
    if (!button || button.dataset.musicReady) return;

    const source = new URL(button.dataset.audioSrc ?? '', window.location.href).href;
    if (!win.portfolioAudio || win.portfolioAudio.src !== source) {
      win.portfolioAudio?.pause();
      win.portfolioAudio = new Audio(source);
      win.portfolioAudio.loop = true;
    }

    const audio = win.portfolioAudio;
    const updateButton = () => {
      const playing = !audio.paused;
      button.classList.toggle('is-playing', playing);
      button.setAttribute('aria-pressed', String(playing));
      button.setAttribute('aria-label', playing ? 'Mettre la musique en pause' : 'Lire la musique');
    };

    button.dataset.musicReady = 'true';
    button.addEventListener('click', async () => {
      if (audio.paused) {
        try { await audio.play(); } catch (error) {
          updateButton();
          if (import.meta.env.DEV) console.error('Lecture audio impossible.', error);
          return;
        }
      } else {
        audio.pause();
      }
      updateButton();
    });
    audio.addEventListener('play', updateButton);
    audio.addEventListener('pause', updateButton);

    const isDevPlayer = button.parentElement?.classList.contains('is-dev');
    if (isDevPlayer && !win.portfolioDevAudioFocusReady) {
      win.portfolioDevAudioFocusReady = true;
      const pauseWhenInactive = () => audio.pause();
      window.addEventListener('blur', pauseWhenInactive);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) pauseWhenInactive();
      });
    }

    updateButton();
  };

  setupMusicPlayer();
  document.addEventListener('astro:page-load', setupMusicPlayer);
</script>

<style>
  /* Icônes, états de lecture et couleurs du lecteur musical. */
  .music-player-control { position: relative; z-index: 20; flex: 0 0 42px; width: 42px; height: 42px; }
  .music-player-control.is-fixed { position: fixed; top: clamp(1rem, 3vw, 2rem); right: clamp(1rem, 3vw, 2rem); }
  .music-play-button { display: grid; width: 42px; height: 42px; padding: 0; place-items: center; border: 0; border-radius: 50%; background: currentColor; cursor: pointer; transition: transform .2s ease, opacity .2s ease; }
  .music-play-button:hover { transform: scale(1.06); }
  .music-play-button:focus-visible { outline: 3px solid #ff8a5b; outline-offset: 4px; }
  .is-creative { color: #0000FF; }
  .is-dev { color: #0000FF; }
  .sound-icon { width: 21px; height: 21px; fill: none; stroke: #fff; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }
  .sound-wave { opacity: .4; transition: opacity .2s ease, stroke-width .2s ease; }
  .is-creative .music-play-button { background: #0000FF; }
  .is-dev .music-play-button { background: #fff; }
  .is-dev .sound-icon { stroke: #0000FF; }
  .music-play-button.is-playing .sound-wave { opacity: 1; stroke-width: 1.8; }
  @media (prefers-reduced-motion: reduce) { .sound-wave { transition: none; } }
</style>
