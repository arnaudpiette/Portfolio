---
interface Props {
  theme?: 'light' | 'dark';
  sectionId?: string;
  showFooter?: boolean;
}

const { theme = 'light', sectionId = 'contact', showFooter = true } = Astro.props;
const quote = 'Depuis 20 ans, je crée des campagnes publicitaires, développe des identités de marque (maintenant des sites web et des applications) et imagine des expériences digitales nationales et internationales, tant pour des Agences de Publicité, telles que PUBLICIS, MC CANN, OGILVY, LIEU COMMUN que pour des marques ou des start-up comme DECATHLON, VIGNERONS INDÉPENDANTS, L’ORÉAL, NIKE, JOUÉCLUB, OPEL, HARLEY-DAVIDSON, LOTERIE NATIONALE, AXA, CROIX-ROUGE, DR MILOU, WHEELIZ, AUTONOMY, CITYSCOOT...';
---

<section id={sectionId} class:list={['contact-block', `contact-${theme}`]}>
  <div class="contact-heading">
    <h2>Une question ?</h2>
  </div>

  <form class="contact-form" action="https://formsubmit.co/ajax/arno.piette@gmail.com" method="POST">
    <input type="hidden" name="_subject" value="Contact from arnaud-piette.com" />
    <input type="hidden" name="_template" value="table" />
    <input class="contact-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" />

    <div class="contact-details">
      <label class="floating-field">
        <input type="text" name="name" autocomplete="name" placeholder=" " required />
        <span>Nom</span>
      </label>
      <label class="floating-field">
        <input type="email" name="email" autocomplete="email" placeholder=" " required />
        <span>Email</span>
      </label>
    </div>

    <label class="message-field">
      <span>Message</span>
      <textarea name="message" rows="9" required data-contact-message data-default-message={quote}>{quote}</textarea>
    </label>

    <div class="contact-submit-row">
      <p class="form-status" aria-live="polite" data-form-status></p>
      <button type="submit">Envoyer <span aria-hidden="true">↗</span></button>
    </div>
  </form>
</section>

{showFooter && (
  <footer class:list={['site-copyright', `copyright-${theme}`]}>
    <p>Copyright 2026 - arno.piette@gmail.com - arnaudpiette.com</p>
  </footer>
)}

<script>
  const setupContactForms = () => {
    document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
      if (form.dataset.ready === 'true') return;
      form.dataset.ready = 'true';

      const message = form.querySelector<HTMLTextAreaElement>('[data-contact-message]');
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      message?.addEventListener('focus', () => {
        if (message.value === message.dataset.defaultMessage) message.value = '';
      });

      message?.addEventListener('blur', () => {
        if (message.value.trim() === '') message.value = message.dataset.defaultMessage ?? '';
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        if (status) status.textContent = 'Envoi en cours…';
        if (submit) submit.disabled = true;

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) throw new Error('Échec de l’envoi');
          form.reset();
          if (message) message.value = message.dataset.defaultMessage ?? '';
          if (status) status.textContent = 'Merci, votre message a bien été envoyé.';
        } catch {
          if (status) status.textContent = 'L’envoi a échoué. Réessayez ou écrivez à arno.piette@gmail.com.';
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    });
  };

  document.addEventListener('astro:page-load', setupContactForms);
  setupContactForms();
</script>

<style>
  .contact-block {
    box-sizing: border-box;
    width: calc(100% - clamp(2rem, 5vw, 6rem));
    margin: 3rem auto 1rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--contact-border);
    border-radius: 32px;
    background: var(--contact-background);
    color: var(--contact-text);
  }
  .site-copyright {
    box-sizing: border-box;
    width: calc(100% - clamp(2rem, 5vw, 6rem));
    margin: 0 auto;
    padding: 1.25rem 0 2.5rem;
    background: transparent;
    text-align: center;
  }
  .site-copyright p {
    margin: 0;
    color: var(--copyright-color);
    font-size: .72rem;
    line-height: 1.5;
    letter-spacing: .08em;
  }
  .copyright-light { --copyright-color: #8f8983; }
  .copyright-dark { --copyright-color: #858585; }
  .contact-block * { box-sizing: border-box; }
  .contact-light { --contact-background: #fafafa; --contact-text: #0000FF; --contact-muted: #8f8983; --contact-border: rgba(0, 0, 255,.1); --contact-field: #fff; --contact-accent: #ff8a5b; --contact-button-text: #16110e; }
  .contact-dark { --contact-background: #07100d; --contact-text: #f5f5f5; --contact-muted: #858f89; --contact-border: #213d32; --contact-field: #030908; --contact-accent: #9af57f; --contact-button-text: #03100a; }
  .contact-heading { margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  h2 { margin: 0; font-size: clamp(1.4rem, 3.5vw, 3rem); line-height: .9; letter-spacing: -.055em; }
  .contact-form { display: grid; gap: 1rem; }
  .contact-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 20px; }
  label { min-width: 0; }
  .message-field { position: relative; display: block; }
  .message-field > span,
  .floating-field > span { color: var(--contact-accent); font-size: .68rem; text-transform: uppercase; letter-spacing: .16em; }
  .message-field > span {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 1.25rem;
    padding: 0 .35rem;
    background: var(--contact-background);
    transform: translate(-.35rem, -50%);
  }
  .floating-field { position: relative; display: block; height: 52px; }
  .floating-field > span {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 1.25rem;
    padding: 0 .35rem;
    background: var(--contact-field);
    transform: translate(-.35rem, -50%);
    pointer-events: none;
    transition: top .2s ease, background-color .2s ease;
  }
  .floating-field:hover > span,
  .floating-field:focus-within > span,
  .floating-field input:not(:placeholder-shown) + span {
    top: 0;
    background: var(--contact-background);
    transform: translate(-.35rem, -50%);
  }
  input, textarea {
    box-sizing: border-box;
    width: 100%;
    border: 1px solid var(--contact-border);
    border-radius: 18px;
    outline: 0;
    background: var(--contact-field);
    color: var(--contact-text);
    font: inherit;
    transition: border-color .2s ease;
  }
  input { min-height: 52px; height: 52px; padding: 0 1.25rem; }
  textarea { min-height: 230px; padding: 1.25rem; resize: vertical; color: var(--contact-muted); line-height: 1.65; }
  input:focus, textarea:focus { border-color: var(--contact-accent); }
  .contact-submit-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .form-status { min-height: 1.4em; margin: 0; color: var(--contact-muted); font-size: .82rem; }
  button { min-width: 130px; height: 46px; padding: 0 1.2rem; border: 1px solid var(--contact-accent); border-radius: 999px; background: var(--contact-accent); color: var(--contact-button-text); font: inherit; cursor: pointer; }
  button:hover { background: transparent; color: var(--contact-accent); }
  button:disabled { cursor: wait; opacity: .55; }
  .contact-honey { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  @media (max-width: 640px) {
    .contact-details { grid-template-columns: 1fr; }
    .contact-submit-row { align-items: stretch; flex-direction: column; }
    button { width: 100%; }
  }
</style>
