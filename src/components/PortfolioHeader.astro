---
// Réutilise le lecteur musical dans le menu rapide du header.
import MusicPlayButton from './MusicPlayButton.astro';

// Décrit le mode visuel et éditorial du header.
interface Props {
  mode: 'creative' | 'dev';
  // Permet aux pages détail de réserver la hiérarchie des titres au contenu principal.
  headingLevel?: 'h1' | 'h2' | 'p';
}

// Détermine le texte, le thème et la musique du portfolio courant.
const { mode, headingLevel = 'h1' } = Astro.props;
const isDev = mode === 'dev';
// Rend le niveau de titre demandé sans changer l'apparence du header.
const Heading = headingLevel;
const title = isDev
  ? 'Front-end | Back-end | Creative developer'
  : 'DC/DA | Graphisme | Web Design | UX-UI';
---

<!-- Header commun : identité, accès aux overlays et lecteur musical. -->
<header class:list={['portfolio-header', { 'is-dev': isDev }]}>
  <div class="portfolio-brand-block">
    <Heading class="portfolio-brand-title">
      <a href="/" data-astro-reload>
        {title}
      </a>
    </Heading>
    <p class="portfolio-brand-subtitle">Arnaud Piette</p>
  </div>
  <div class="portfolio-menu" aria-label="Menu rapide">
    <button class="portfolio-menu-button" type="button" data-overlay-open="portfolio-skills-dialog" aria-label="Afficher les compétences">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h5v5H5zM14 5h5v5h-5zM5 14h5v5H5zM14 14h5v5h-5z"/></svg>
    </button>
    <button class="portfolio-menu-button" type="button" data-overlay-open="portfolio-contact-dialog" aria-label="Ouvrir le contact">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6"/></svg>
    </button>
    <MusicPlayButton theme={isDev ? 'dev' : 'creative'} />
  </div>
</header>

<style>
  /* Mise en page du header, de son identité et de ses actions rapides. */
  .portfolio-header {
    position: relative;
    box-sizing: border-box;
    display: flex;
    width: calc(100% - clamp(2rem, 5vw, 6rem));
    margin: 2rem auto 42px;
    padding: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    overflow: visible;
    border: 0;
    background: transparent;
    color: #0000FF;
  }
  .portfolio-header * { box-sizing: border-box; }
  .portfolio-brand-block {
    display: flex;
    min-height: 42px;
    flex-direction: column;
    justify-content: center;
  }
  .portfolio-brand-title {
    margin: 0 0 .35rem;
    font-size: 15px;
    font-weight: 300;
    line-height: .95;
    letter-spacing: .12em;
    white-space: nowrap;
  }
  .portfolio-brand-title a,
  .portfolio-brand-title a:visited,
  .portfolio-brand-title a:hover,
  .portfolio-brand-title a:active {
    display: inline;
    color: inherit !important;
    font: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    text-decoration: none !important;
  }
  .portfolio-brand-subtitle {
    margin: 0;
    color: #ff8a5b;
    font-size: 14px;
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: .24em;
  }
  .portfolio-header.is-dev {
    border-color: transparent;
    background: transparent;
    color: #fff;
  }
  .portfolio-header.is-dev .portfolio-brand-subtitle { color: #9af57f; }
  .portfolio-menu { display: flex; align-items: center; gap: .65rem; }
  .portfolio-menu-button {
    box-sizing: border-box;
    display: grid;
    flex: 0 0 42px;
    min-width: 42px;
    max-width: 42px;
    width: 42px;
    min-height: 42px;
    max-height: 42px;
    height: 42px;
    margin: 0;
    padding: 0;
    place-items: center;
    appearance: none;
    border: 1px solid color-mix(in srgb, currentColor 50%, transparent);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background-color .2s ease, color .2s ease, transform .2s ease;
  }
  .portfolio-menu-button svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .portfolio-menu-button:hover { background: #ff8a5b; color: #fff; transform: scale(1.06); }
  .portfolio-header:not(.is-dev) .portfolio-menu-button:hover { border-color: transparent; }
  .portfolio-menu-button:focus-visible { outline: 3px solid #ff8a5b; outline-offset: 3px; }
  .portfolio-header.is-dev .portfolio-menu-button { color: #9af57f; }
  .portfolio-header.is-dev .portfolio-menu-button:hover { background: #9af57f; color: #0000FF; }
  .portfolio-header.is-dev .portfolio-menu-button:focus-visible { outline-color: #9af57f; }
  .portfolio-header :global(.music-play-button) { transition: transform .2s ease, opacity .2s ease, background-color .2s ease; }
  .portfolio-header:not(.is-dev) :global(.music-play-button:hover) { background: #ff8a5b; }
  .portfolio-header:not(.is-dev) :global(.music-play-button:hover .play-icon) { border-left-color: #fff; }
  .portfolio-header:not(.is-dev) :global(.music-play-button:hover .pause-icon i) { background: #fff; }
  .portfolio-header.is-dev :global(.music-play-button:hover) { background: #9af57f; }

  @media (max-width: 760px) {
    .portfolio-header {
      align-items: center;
      flex-direction: column;
      gap: .75rem;
      margin-bottom: 22px;
      padding-bottom: clamp(1rem, 2vw, 1.5rem);
    }
    .portfolio-brand-block {
      width: 100%;
      min-height: 42px;
      padding-right: 0;
      align-items: center;
      text-align: center;
    }
    .portfolio-brand-title {
      font-size: 15px;
      line-height: .95;
      letter-spacing: .12em;
    }
    .portfolio-brand-subtitle {
      font-size: 14px;
      line-height: 1.35;
      min-height: 2.7em;
    }
    .portfolio-menu {
      position: static;
      order: -1;
      align-self: center;
      justify-content: center;
    }
  }
</style>
