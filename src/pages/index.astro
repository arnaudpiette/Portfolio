---
import BaseLayout from '../layouts/BaseLayout.astro';

// Définit le nombre de traits animés derrière chaque carte de la page d'entrée.
const cardStackLayers = Array.from({ length: 12 });
const devCardStackLayers = Array.from({ length: 7 });
---

<!-- Encadre la page d'entrée avec les métadonnées et transitions communes. -->
<BaseLayout
  title="Arnaud Piette — Directeur artistique & Développeur web"
  description="Portfolio d’Arnaud Piette, directeur artistique et développeur web : direction créative, graphisme, webdesign, UX/UI et développement web."
>
    <!-- Présente les deux accès principaux au portfolio. -->
    <main>
      <h1 class="sr-only">Arnaud Piette — Directeur artistique & Développeur web</h1>

      <section class="entry-grid" aria-label="Choisir un portfolio">
        <div class="card-stage card-stage--creative">
          <a class="entry-card creative-card" href="/creative">
            <div class="card-stack" aria-hidden="true">
              {cardStackLayers.map((_, index) => (
                <span style={`--stack-opacity:${0.82 - index * 0.045};--stack-depth:${index + 1};`}></span>
              ))}
              <i></i><i></i><i></i><i></i>
            </div>
            <span class="card-index">01 / 02</span>
            <div class="card-copy">
              <h2>CRÉA</h2>
              <p>Direction créative & artistique</p>
            </div>
            <span class="arrow" aria-hidden="true">&gt;</span>
          </a>
        </div>

        <div class="card-stage card-stage--dev">
          <a class="entry-card dev-card" href="/dev">
            <div class="card-stack" aria-hidden="true">
              {devCardStackLayers.map((_, index) => (
                <span style={`--stack-opacity:${0.82 - index * 0.045};--stack-depth:${index + 1};`}></span>
              ))}
            </div>
            <span class="card-index">02 / 02</span>
            <div class="card-copy">
              <h2>DEV</h2>
              <p>Développement web</p>
            </div>
            <span class="arrow" aria-hidden="true">&gt;</span>
          </a>
        </div>
      </section>
    </main>

    <script>
      // Calcule les transformations nécessaires à l'animation d'expansion des cartes.
      const cardStages = document.querySelectorAll<HTMLElement>('.card-stage');

      const updateCardExpansion = () => {
        cardStages.forEach((stage) => {
          const rect = stage.getBoundingClientRect();
          const isCreative = stage.classList.contains('card-stage--creative');
          const targetWidth = isCreative ? rect.right : window.innerWidth - rect.left;
          stage.style.setProperty('--expand-x', isCreative ? `${-rect.left}px` : '0px');
          stage.style.setProperty('--expand-y', `${-rect.top}px`);
          stage.style.setProperty('--expand-scale-x', String(targetWidth / rect.width));
          stage.style.setProperty('--expand-scale-y', String(window.innerHeight / rect.height));
          if (isCreative) {
            stage.style.setProperty('--creative-stroke-width', `${1.5 / (window.innerHeight / rect.height)}px`);
            stage.style.setProperty('--creative-vertical-width', `${1.5 / (targetWidth / rect.width)}px`);
            stage.style.setProperty('--creative-cross-length', `${20 / (window.innerHeight / rect.height)}px`);
          }

          const layers = stage.querySelectorAll<HTMLElement>('.card-stack span');
          layers.forEach((layer, index) => {
            const progress = (index + 1) / layers.length;
            const fullTranslateX = isCreative ? -rect.left : 0;
            const fullTranslateY = -rect.top;
            const fullScaleX = targetWidth / rect.width;
            const fullScaleY = window.innerHeight / rect.height;
            layer.style.setProperty('--stroke-x', `${fullTranslateX * progress}px`);
            layer.style.setProperty('--stroke-y', `${fullTranslateY * progress}px`);
            layer.style.setProperty('--stroke-scale-x', String(1 + (fullScaleX - 1) * progress));
            layer.style.setProperty('--stroke-scale-y', String(1 + (fullScaleY - 1) * progress));
            if (isCreative) {
              layer.style.setProperty('--diagonal-top', `${((index + .5) / layers.length) * 100}%`);
            }
          });
        });
      };

      updateCardExpansion();
      window.addEventListener('resize', updateCardExpansion, { passive: true });

    </script>
</BaseLayout>

<style>
  /* Fondations visuelles et mise en page de la page d'entrée. */
  :root { font-family: Inter, 'Helvetica Neue', Arial, sans-serif; color: #0000FF; background: #f4f1eb; }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; overflow-x: hidden; background: #f4f1eb; }
  main { min-height: 100svh; display: grid; align-items: center; padding: clamp(3rem, 7vw, 7rem); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .entry-grid { width: min(1120px, 100%); margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.25rem, 2.5vw, 2.5rem); isolation: isolate; }
  /* Conteneur positionné qui porte les interactions de chaque carte. */
  .card-stage {
    position: relative;
    min-width: 0;
  }
  .card-stage:hover,
  .card-stage:focus-within { z-index: 30; }
  /* Empile les traits décoratifs animés derrière les cartes. */
  .card-stack {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    overflow: visible;
    border-radius: inherit;
    transition: opacity .25s ease;
  }
  .card-stage:hover .card-stack,
  .card-stage:focus-within .card-stack { opacity: 1; }
  .card-stack span {
    position: absolute;
    inset: 0;
    display: block;
    border: 1.5px solid currentColor;
    border-radius: clamp(1.5rem, 3vw, 3rem);
    opacity: var(--stack-opacity);
    transform-origin: top left;
    transition: transform .9s cubic-bezier(.22, 1, .36, 1), border-radius .9s cubic-bezier(.22, 1, .36, 1), clip-path .9s cubic-bezier(.22, 1, .36, 1);
    transition-delay: calc(var(--stack-depth) * 28ms);
    transform: translate3d(0, 0, 0) scale(1);
    backface-visibility: hidden;
    will-change: transform;
  }
  .card-stage--creative .card-stack { color: #ff6b3d; }
  .card-stage--creative .card-stack {
    transform-origin: top left;
    transition: opacity .25s ease, transform .8s cubic-bezier(.22, 1, .36, 1), border-radius .8s cubic-bezier(.22, 1, .36, 1);
  }
  .card-stage--dev .card-stack { color: #68e99a; }
  .card-stage--creative .card-stack span { clip-path: inset(0 100% 0 0); }
  .card-stage--creative, .card-stage--dev { transform: none; }
  /* Définit l'apparence et la structure commune des deux liens principaux. */
  .entry-card {
    position: relative; z-index: 10; min-height: clamp(360px, 55vh, 560px);
    padding: clamp(1.5rem, 3vw, 2.5rem); border: 0;
    border-radius: clamp(1.5rem, 3vw, 3rem); display: flex; flex-direction: column;
    justify-content: space-between; color: #0000FF; text-decoration: none;
    box-shadow: none;
    isolation: isolate;
  }
  .entry-card::before {
    content: '';
    position: absolute;
    z-index: -2;
    inset: 0;
    border: 1px solid var(--card-border, rgba(0, 0, 255, .12));
    border-radius: inherit;
    background: var(--card-background);
    transform-origin: top left;
    transition: border-color .2s ease, transform .8s cubic-bezier(.22, 1, .36, 1), border-radius .8s cubic-bezier(.22, 1, .36, 1);
    transform: translate3d(0, 0, 0) scale(1);
    backface-visibility: hidden;
    will-change: transform;
  }
  .entry-card:focus-visible { outline: 2px solid #ff6b3d; outline-offset: 4px; }
  .creative-card { --card-background: #fffdf9; }
  .dev-card {
    --card-border: #0000FF;
    --card-background:
      radial-gradient(circle at 82% 18%, rgba(154, 245, 127, .25), transparent 34%),
      radial-gradient(circle at 12% 88%, rgba(0, 0, 255, .42), transparent 48%),
      linear-gradient(145deg, #0b1b16, #030908);
    color: #fff;
  }
  .dev-card .card-copy p,
  .dev-card .arrow { color: #9af57f; }
  .dev-card:focus-visible { outline-color: #9af57f; }
  /* Active l'expansion complète uniquement pour les pointeurs précis. */
  @media (hover: hover) and (pointer: fine) {
    .card-stage:hover .entry-card::before,
    .card-stage:focus-within .entry-card::before {
      transform: translate3d(var(--expand-x), var(--expand-y), 0) scale(var(--expand-scale-x), var(--expand-scale-y));
      border-radius: 0;
    }
    .card-stage:hover .card-stack span,
    .card-stage:focus-within .card-stack span {
      transform: translate3d(var(--stroke-x), var(--stroke-y), 0) scale(var(--stroke-scale-x), var(--stroke-scale-y));
      border-radius: clamp(.25rem, 1.5vw, 1.5rem);
      clip-path: inset(0);
    }
    .card-stage--creative:hover .card-stack,
    .card-stage--creative:focus-within .card-stack {
      overflow: hidden;
      transform: translate3d(var(--expand-x), var(--expand-y), 0) scale(var(--expand-scale-x), var(--expand-scale-y));
      border-radius: 0;
    }
    .card-stage--creative:hover .card-stack span,
    .card-stage--creative:focus-within .card-stack span {
      transform: rotate(-22deg) scaleX(1);
      border-radius: 0;
      clip-path: inset(0);
    }
    .card-stage--creative:hover .card-stack i,
    .card-stage--creative:focus-within .card-stack i {
      transform: translateY(-50%) scaleY(1);
    }
  }
  .card-stage--creative .card-stack span {
    inset: auto;
    position: absolute;
    top: var(--diagonal-top, 50%);
    left: -30%;
    width: 160%;
    height: 0;
    border: 0;
    border-top: var(--creative-stroke-width, 1.5px) solid currentColor;
    border-radius: 0;
    transform: rotate(-22deg) scaleX(0);
    transform-origin: center;
    transition: transform .9s cubic-bezier(.22, 1, .36, 1), border-radius .9s cubic-bezier(.22, 1, .36, 1), clip-path .9s cubic-bezier(.22, 1, .36, 1);
    transition-delay: calc(var(--stack-depth) * 28ms);
    will-change: transform;
  }
  .card-stage--creative .card-stack span::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    border-top: inherit;
    transform: rotate(44deg);
    transform-origin: center;
  }
  .card-stage--creative .card-stack i {
    position: absolute;
    width: 0;
    height: var(--creative-cross-length, 20px);
    border-left: var(--creative-vertical-width, 1.5px) solid currentColor;
    transform: translateY(-50%) scaleY(0);
    transform-origin: center;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1);
  }
  .card-stage--creative .card-stack i:nth-of-type(1) { top: 28%; left: 24%; transition-delay: .18s; }
  .card-stage--creative .card-stack i:nth-of-type(2) { top: 63%; left: 72%; transition-delay: .32s; }
  .card-stage--creative .card-stack i:nth-of-type(3) { top: 44%; left: 48%; transition-delay: .46s; }
  .card-stage--creative .card-stack i:nth-of-type(4) { top: 77%; left: 87%; transition-delay: .6s; }
  .card-index { align-self: flex-end; font-size: .68rem; letter-spacing: .16em; opacity: .45; }
  .card-copy { position: relative; isolation: isolate; }
  .card-copy p { margin: 1.125rem 0 0; color: #ff6b3d; font-size: clamp(.65rem, 1vw, .8rem); line-height: 1.2; text-transform: uppercase; letter-spacing: .2em; }
  h2 { position: relative; z-index: 1; display: inline-block; margin: 0; font-size: clamp(4.2rem, 10vw, 9rem); line-height: .75; letter-spacing: -.075em; }
  .arrow { position: absolute; right: clamp(1.5rem, 3vw, 2.5rem); bottom: clamp(1.5rem, 3vw, 2.5rem); font-size: clamp(1.8rem, 3vw, 2.8rem); }
  /* Empile les cartes sur les écrans étroits. */
  @media (max-width: 900px) {
    main { padding: 1rem; }
    .entry-grid { grid-template-columns: 1fr; gap: 2rem; padding: 1rem 0; }
    .card-stage--creative, .card-stage--dev { transform: none; }
    .entry-card { min-height: clamp(260px, 42svh, 380px); }
    h2 { font-size: clamp(4rem, 22vw, 8rem); }
  }
  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .card-stack span:nth-child(n + 8) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .entry-card::before { transition: border-color .2s ease; }
  }
</style>
