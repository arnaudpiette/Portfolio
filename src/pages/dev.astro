---
// Charge les données de la grille et des filtres DEV.
import { devFilters, devProjects } from '../data/devProjects';
// Réutilise la liste de compétences DEV dans l'overlay de la page.
import { devSkillGroups } from '../data/devSkills';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/portfolio-shared.css';
import ModeSwitch from '../components/ModeSwitch.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import PortfolioOverlays from '../components/PortfolioOverlays.astro';
import PortfolioSignature from '../components/PortfolioSignature.astro';

const devStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Portfolio Développement web — Arnaud Piette',
  url: 'https://arnaudpiette.com/dev',
  description: 'Portfolio développement web d’Arnaud Piette : projets front-end et back-end en JavaScript, React, Node.js, API REST, performance et accessibilité.',
  creator: { '@id': 'https://arnaudpiette.com/#person' },
};

---

<!-- Page DEV : header, filtres, repositories GitHub et overlays. -->
<BaseLayout
  title="Arnaud Piette — Développeur web Front-end & Back-end"
  description="Portfolio développement web d’Arnaud Piette : projets front-end et back-end en JavaScript, React, Node.js, API REST, performance et accessibilité."
  pageTransition="dev"
  ogImage="/projets/dev/noon/cover.webp"
  ogImageAlt="Projet Noon du portfolio développement web d’Arnaud Piette"
  structuredData={devStructuredData}
>
    <PortfolioHeader mode="dev" headingLevel="p" />

    <!-- Racine propre à DEV : les scripts de filtre restent isolés après un swap Astro. -->
    <main id="projects" data-projects-page="dev">
      <PortfolioSignature theme="dark" />
      <div class="filter-toolbar">
        <div class="filter-controls">
          <ModeSwitch mode="dev" preserveScroll />
          <button class="filter-toggle" data-filter-toggle type="button" aria-expanded="false" aria-controls="dev-filters" aria-label="Afficher les filtres">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="14" cy="17" r="2"/></svg>
          </button>
        </div>
        <div id="dev-filters" class="filter-list" data-filter-panel aria-hidden="true" inert>
          <section class="filters" aria-label="Filtres des projets DEV">
            {devFilters.map(([id, label]) => <button class:list={['filter-pill', { active: id === 'all' }]} data-filter={id} type="button">{label}</button>)}
          </section>
        </div>
      </div>

      <section class="project-grid" aria-label="Projets de développement web">
        {devProjects.map((project, index) => (
          <article class="project-card" data-project-card data-categories={project.filters.join(' ')}>
            <!-- La carte mène vers la fiche interne ; GitHub reste disponible sur cette fiche. -->
            <a href={`/dev/projets/${project.slug}`} aria-label={`Voir la fiche projet ${project.name}`}>
              <div class="project-visual">
                {(project.cardCover ?? project.cover) && <img class:list={['project-cover', `project-cover-${(project.cardCover ?? project.cover)?.type ?? 'cover'}`]} src={(project.cardCover ?? project.cover)?.src} alt={(project.cardCover ?? project.cover)?.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}
                <span>{String(index + 1).padStart(2, '0')}</span>
                {!project.cover && <span class="repo-mark">&lt;/&gt;</span>}
              </div>
              <div class="project-content">
                <div class="project-tags">{project.stack.map((tag) => <span>{tag}</span>)}</div>
                <h3>{project.name}</h3>
                <span class="github-link">Voir le projet</span>
              </div>
            </a>
          </article>
        ))}
      </section>

    </main>

    <PortfolioFooter theme="dark" />
    <PortfolioOverlays theme="dark" groups={devSkillGroups} />
    <script>
      // Installe le filtrage des repositories et l'ouverture du panneau de filtres.
      // Associe les filtres aux cartes selon leurs catégories déclarées.
      const setupProjectFilters = () => {
        // Évite que ce script persistant traite les contrôles CRÉA après une navigation ClientRouter.
        const root = document.querySelector<HTMLElement>('[data-projects-page="dev"]');
        if (!root) return;

        const buttons = root.querySelectorAll('[data-filter]');
        const cards = root.querySelectorAll('[data-project-card]');

        buttons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.filterReady) return;
          button.dataset.filterReady = 'true';
          button.addEventListener('click', () => {
            const filter = button.getAttribute('data-filter');
            buttons.forEach((item) => item.classList.remove('active'));
            button.classList.add('active');
            cards.forEach((card) => {
              const categories = card.getAttribute('data-categories')?.split(' ') ?? [];
              card.classList.toggle('is-hidden', filter !== 'all' && !categories.includes(filter ?? ''));
            });
          });
        });
      };

      setupProjectFilters();
      document.addEventListener('astro:page-load', setupProjectFilters);

      // Met à jour les attributs d'accessibilité du panneau repliable.
      const setupFilterToggle = () => {
        // Réserve le panneau de filtres à la page DEV courante.
        const root = document.querySelector<HTMLElement>('[data-projects-page="dev"]');
        if (!root) return;

        const toggle = root.querySelector<HTMLButtonElement>('[data-filter-toggle]');
        const panel = root.querySelector<HTMLElement>('[data-filter-panel]');
        if (!toggle || !panel || toggle.dataset.toggleReady) return;
        toggle.dataset.toggleReady = 'true';
        toggle.addEventListener('click', () => {
          const isOpen = panel.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(isOpen));
          toggle.setAttribute('aria-label', isOpen ? 'Masquer les filtres' : 'Afficher les filtres');
          panel.setAttribute('aria-hidden', String(!isOpen));
          panel.toggleAttribute('inert', !isOpen);
        });
      };

      setupFilterToggle();
      document.addEventListener('astro:page-load', setupFilterToggle);

      // Sur smartphone, le premier tap révèle les informations de la carte ;
      // le second conserve la navigation native vers la fiche projet.
      const setupMobileProjectCards = () => {
        const root = document.querySelector<HTMLElement>('[data-projects-page="dev"]');
        if (!root || !window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;

        root.querySelectorAll<HTMLAnchorElement>('[data-project-card] > a').forEach((link) => {
          if (link.dataset.mobileRevealReady) return;
          link.dataset.mobileRevealReady = 'true';
          link.addEventListener('click', (event) => {
            // Les actions clavier restent des liens normaux et immédiatement accessibles.
            if (event.detail === 0 || link.closest('.project-card')?.classList.contains('is-revealed')) return;
            event.preventDefault();
            link.closest('.project-card')?.classList.add('is-revealed');
          });
        });
      };

      setupMobileProjectCards();
      document.addEventListener('astro:page-load', setupMobileProjectCards);

    </script>
</BaseLayout>

<style>
  /* Thème sombre, contrôles de filtre et grille des projets DEV. */
  :root { font-family: Inter, 'Segoe UI', sans-serif; color: #f5f5f5; background: #030908; color-scheme: dark; }
  html { scrollbar-gutter: stable; }
  * { box-sizing: border-box; }
  body { margin: 0; background: radial-gradient(circle at 75% 0%, rgba(0,0,255,.14), transparent 34rem), #030908; color: #f5f5f5; }
  header, main, footer { width: calc(100% - clamp(2rem, 5vw, 6rem)); margin: 0 auto; }
  h1 { margin: 0 0 .35rem; line-height: .95; letter-spacing: -.045em; }
  .project-content p, footer { color: #858585; line-height: 1.55; }
  .filters { display: grid; grid-template-columns: repeat(9,minmax(0,1fr)); gap: 15px; width: 100%; margin: 0; }
  .filter-list { width: 100%; max-height: 0; overflow: hidden; opacity: 0; transform: scaleX(0); transform-origin: left center; pointer-events: none; transition: max-height .45s ease, opacity .3s ease, transform .45s ease; }
  .filter-list.is-open { max-height: 400px; opacity: 1; transform: scaleX(1); pointer-events: auto; }
  .filter-toolbar { display: flex; flex-direction: column; align-items: stretch; gap: 2rem; margin: calc(2rem - 100px) 0 0; padding: 70px 0 2rem; }
  .filter-controls { display: flex; align-items: center; justify-content: center; gap: .75rem; }
  .filter-controls > :global(.mode-switch) { flex: 0 0 auto; width: 182px; height: 55px; }
  .filter-toggle { display: grid; flex: 0 0 55px; width: 55px; height: 55px; padding: 0; place-items: center; border: 1px solid rgba(154,245,127,.48); border-radius: 50%; background: #07100d; color: #9af57f; cursor: pointer; }
  .filter-toggle svg { width: 32.5px; height: 32.5px; overflow: visible; fill: #07100d; stroke: currentColor; stroke-width: 1; stroke-linecap: round; }
  .filter-toggle:hover, .filter-toggle[aria-expanded='true'] { border-color: #0000FF; background: #0000FF; color: #9af57f; }
  .filter-toggle:hover svg, .filter-toggle[aria-expanded='true'] svg { fill: #0000FF; }
  .filter-toggle:focus-visible { outline: 3px solid #9af57f; outline-offset: 3px; }
  .filter-pill { display: inline-flex; width: 100%; min-width: 0; height: 42px; padding: .7rem .25rem; align-items: center; justify-content: center; border: 1px solid #0000FF; border-radius: 999px; background: transparent; color: rgba(245,245,245,.5); font-size: clamp(.65rem,1.1vw,.83rem); white-space: nowrap; text-align: center; cursor: pointer; }
  .filter-pill:hover, .filter-pill.active { border-color: #0000FF; background: #0000FF; color: #9af57f; }
  /* La grille desktop affiche quatre projets par ligne pour améliorer la lisibilité des cartes. */
  .project-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .6rem; padding-bottom: 3rem; }
  .project-card { position: relative; aspect-ratio: 1 / 1; overflow: hidden; border: 1px solid #0000FF; border-radius: 24px; background: #07100d; transition: transform .2s ease, border-color .2s ease; }
  .project-card:hover { transform: translateY(-4px); border-color: #0000FF; }
  .project-card.is-hidden { display: none; }
  .project-card > a { position: relative; display: flex; height: 100%; flex-direction: column; color: inherit; text-decoration: none; }
  .project-visual { position: absolute; z-index: 1; inset: 0; display: flex; margin: 0; padding: 1rem; justify-content: space-between; overflow: hidden; background: radial-gradient(circle at 82% 18%, rgba(154,245,127,.25), transparent 34%), radial-gradient(circle at 12% 88%, rgba(0,0,255,.42), transparent 48%), linear-gradient(145deg,#0b1b16,#030908); color: #fff; }
  .project-cover { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .project-cover-architecture { padding: 1rem; object-fit: contain; background: #07100d; }
  .project-cover-document { object-position: center top; }
  /* La couverture Smokonomy est un écran vertical : ce cadrage conserve la montre entière dans la carte carrée. */
  .project-cover-mobile { object-position: center calc(12% - 15px); }
  .project-visual > span { opacity: 0; transition: opacity .2s ease; }
  .repo-mark { position: absolute; top: 50%; left: 50%; color: #fff; font-size: clamp(2.8rem,5vw,4.5rem); font-weight: 700; letter-spacing: -.1em; transform: translate(-50%,-50%); }
  .project-content { position: absolute; z-index: 2; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(1rem,2vw,1.5rem); background: #0000FF; color: #fff; opacity: 0; transform: translateY(12px); transition: opacity .25s ease, transform .25s ease; }
  .project-card:hover .project-content, .project-card > a:focus-visible .project-content { opacity: 1; transform: none; }
  .project-tags { display: flex; flex-wrap: wrap; gap: .35rem .75rem; }
  .project-tags span { color: #9af57f; font-size: clamp(.702rem,.99vw,.81rem); text-transform: uppercase; letter-spacing: .14em; }
  h3 { max-width: 100%; min-width: 0; margin: .9rem 0 .4rem; font-size: clamp(1.44rem,3.06vw,2.7rem); line-height: 1.05; overflow-wrap: normal; word-break: normal; hyphens: none; }
  .project-content p { margin: 0; }
  .github-link { margin-top: auto; padding-top: 1rem; color: #fff; font-size: .943rem; }
  .github-link::after { display: inline-block; margin-left: .35em; opacity: 0; transform: translate3d(-5px, 0, 0); transition: opacity 220ms ease, transform 220ms cubic-bezier(.16, 1, .3, 1); content: '↗'; }
  .project-card:hover .github-link::after,
  .project-card > a:focus-visible .github-link::after,
  .project-card.is-revealed .github-link::after { opacity: .85; transform: translate3d(0, 0, 0); }
  footer { padding-bottom: 2.5rem; }
  @media (max-width: 1100px) { .project-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } .filters { grid-template-columns: repeat(5,minmax(0,1fr)); } }
  @media (max-width: 600px) { .filters { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  @media (max-width: 560px) { .project-grid { grid-template-columns: 1fr; } .filter-toolbar { margin: 2rem 0 0; padding: 0 0 2rem; } }
  @media (max-width: 950px) and (max-height: 560px) and (orientation: landscape) and (hover: none) and (pointer: coarse) { .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (hover: none) and (pointer: coarse) {
    .project-card.is-revealed .project-content { opacity: 1; transform: none; }
    .project-content h3 { margin: .75rem 0 .5rem; font-size: clamp(1.92rem,9.6vw,2.88rem); line-height: 1; letter-spacing: -.045em; white-space: normal; overflow-wrap: normal; word-break: normal; hyphens: none; }
    .github-link { padding-top: 1.25rem; font-size: 1.294rem; font-weight: 600; }
  }
</style>
