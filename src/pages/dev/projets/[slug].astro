---
// Charge le layout, les données DEV et les composants partagés de l'univers DEV.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PortfolioFooter from '../../../components/PortfolioFooter.astro';
import PortfolioHeader from '../../../components/PortfolioHeader.astro';
import PortfolioOverlays from '../../../components/PortfolioOverlays.astro';
import { devProjects, type DevProject } from '../../../data/devProjects';
import { devSkillGroups } from '../../../data/devSkills';

// Génère uniquement les routes correspondant aux slugs déclarés dans les données DEV.
export function getStaticPaths() {
  return devProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// Récupère les données pré-générées de la fiche projet courante.
const { project } = Astro.props as { project: DevProject };
const projectImages = [project.cover, ...(project.gallery ?? [])].filter((image): image is NonNullable<typeof image> => Boolean(image));
const socialImage = project.cover?.src ?? '/projets/dev/noon/cover.webp';
const projectStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  description: project.description,
  url: new URL(`/dev/projets/${project.slug}`, Astro.site ?? Astro.url).href,
  image: new URL(socialImage, Astro.site ?? Astro.url).href,
  creator: { '@id': 'https://arnaudpiette.com/#person' },
  keywords: project.stack.join(', '),
};
---

<!-- Fiche DEV générique : les sections éditoriales restent absentes sans donnée associée. -->
<BaseLayout
  title={project.seoTitle ?? `${project.name} — Projet développement web — Arnaud Piette`}
  description={project.description}
  ogImage={socialImage}
  ogImageAlt={project.cover?.alt ?? 'Aperçu du portfolio développement web d’Arnaud Piette'}
  ogType="article"
  structuredData={projectStructuredData}
>
  <!-- Le libellé de marque n'est pas un titre afin de conserver un seul H1 de page. -->
  <PortfolioHeader mode="dev" headingLevel="p" />

  <main class="project-detail">
    <!-- Navigation courte vers la liste DEV et le changement d'univers existant. -->
    <nav class="project-navigation" aria-label="Navigation du projet">
      <a class="back-link" href="/dev">← Retour aux projets DEV</a>
    </nav>

    <!-- Introduction toujours renseignée à partir des données déjà existantes. -->
    <header class="project-intro">
      <p class="project-kicker">{project.projectType ?? 'Projet développement web'}</p>
      <h1>{project.name}</h1>
      <p class="project-description">{project.description}</p>
    </header>

    {project.cover && (
      <figure class:list={['project-media', 'project-media-cover', `project-media-${project.cover.type ?? 'cover'}`]}>
        <button class="project-image-trigger" type="button" data-dev-image-open="0" aria-label={`Agrandir : ${project.cover.alt}`}>
          <img src={project.cover.src} alt={project.cover.alt} decoding="async" />
        </button>
      </figure>
    )}

    <!-- Stack réalisée ou outils et architecture proposée, selon la nature du projet. -->
    {project.managementTools || project.proposedStack ? (
      <>
        {project.managementTools && project.managementTools.length > 0 && (
          <section class="project-section" aria-labelledby="management-tools-title">
            <h2 id="management-tools-title">Outils de gestion</h2>
            <ul class="tag-list">{project.managementTools.map((item) => <li>{item}</li>)}</ul>
          </section>
        )}
        {project.proposedStack && project.proposedStack.length > 0 && (
          <section class="project-section" aria-labelledby="proposed-stack-title">
            <h2 id="proposed-stack-title">Architecture technique proposée</h2>
            <ul class="tag-list">{project.proposedStack.map((item) => <li>{item}</li>)}</ul>
          </section>
        )}
      </>
    ) : (
      <section class="project-section" aria-labelledby="stack-title">
        <h2 id="stack-title">Stack technique</h2>
        <ul class="tag-list">
          {project.stack.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <!-- Les sections suivantes ne sont rendues que lorsque la donnée éditoriale existe. -->
    {project.context && (
      <section class="project-section" aria-labelledby="context-title">
        <h2 id="context-title">Contexte</h2>
        <p>{project.context}</p>
      </section>
    )}
    {project.objectives && project.objectives.length > 0 && (
      <section class="project-section" aria-labelledby="objectives-title">
        <h2 id="objectives-title">Objectifs</h2>
        <ul>{project.objectives.map((objective) => <li>{objective}</li>)}</ul>
      </section>
    )}
    {project.gallery && project.gallery.length > 0 && (
      <section class="project-section project-gallery" aria-labelledby="gallery-title">
        <h2 id="gallery-title">Visuels du projet</h2>
        <div class="gallery-grid">
          {project.gallery.map((image, index) => (
            <figure class:list={['project-media', `project-media-${image.type ?? 'desktop'}`]}>
              <button class="project-image-trigger" type="button" data-dev-image-open={project.cover ? index + 1 : index} aria-label={`Agrandir : ${image.alt}`}>
                <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
              </button>
            </figure>
          ))}
        </div>
      </section>
    )}

    {projectImages.length > 0 && (
      <dialog class="dev-image-dialog" data-dev-image-dialog aria-label="Image agrandie du projet">
        <div class="dev-image-dialog-stage">
          <button class="dev-image-dialog-close" type="button" data-dev-image-close aria-label="Fermer l’image agrandie">×</button>
          <img data-dev-image-dialog-image src="" alt="" decoding="async" />
        </div>
      </dialog>
    )}
    {project.deliverables && project.deliverables.length > 0 && (
      <section class="project-section" aria-labelledby="deliverables-title">
        <h2 id="deliverables-title">Livrables</h2>
        <ul>{project.deliverables.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}
    {project.projectManagement && project.projectManagement.length > 0 && (
      <section class="project-section" aria-labelledby="project-management-title">
        <h2 id="project-management-title">Gestion de projet</h2>
        <ul>{project.projectManagement.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}
    {(project.architecture?.length || project.architectureFlow?.length || project.architectureDescription) && (
      <section class="project-section" aria-labelledby="architecture-title">
        <h2 id="architecture-title">{project.architectureTitle ?? 'Architecture et composants'}</h2>
        {project.architecture && project.architecture.length > 0 && <ul class="tag-list">{project.architecture.map((component) => <li>{component}</li>)}</ul>}
        {project.architectureFlow && project.architectureFlow.length > 0 && (
          <ol class="architecture-flow" aria-label="Cheminement de l’architecture">
            {project.architectureFlow.map((layer) => <li>{layer}</li>)}
          </ol>
        )}
        {project.architectureDescription && <p>{project.architectureDescription}</p>}
      </section>
    )}
    {project.skills && project.skills.length > 0 && (
      <section class="project-section" aria-labelledby="skills-title">
        <h2 id="skills-title">Compétences</h2>
        <ul class="tag-list">{project.skills.map((skill) => <li>{skill}</li>)}</ul>
      </section>
    )}
    {project.features && project.features.length > 0 && (
      <section class="project-section" aria-labelledby="features-title">
        <h2 id="features-title">Fonctionnalités</h2>
        <ul>{project.features.map((feature) => <li>{feature}</li>)}</ul>
      </section>
    )}
    {project.audit && project.audit.length > 0 && (
      <section class="project-section" aria-labelledby="audit-title">
        <h2 id="audit-title">Audit initial</h2>
        <ul>{project.audit.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}
    {project.performance && project.performance.length > 0 && (
      <section class="project-section" aria-labelledby="performance-title">
        <h2 id="performance-title">Performance</h2>
        <ul>{project.performance.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}
    {project.seo && project.seo.length > 0 && (
      <section class="project-section" aria-labelledby="seo-title">
        <h2 id="seo-title">SEO</h2>
        <ul>{project.seo.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}
    {project.accessibility && project.accessibility.length > 0 && (
      <section class="project-section" aria-labelledby="accessibility-title">
        <h2 id="accessibility-title">Accessibilité</h2>
        <ul>{project.accessibility.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}
    {project.sections?.map((section, index) => (
      <section class="project-section" aria-labelledby={`section-title-${index}`}>
        <div class="section-heading">
          <h2 id={`section-title-${index}`}>{section.title}</h2>
          {section.status && <span class:list={['section-status', `section-status-${section.status}`]}>{section.status === 'current' ? 'V1 — existant / interne' : section.status === 'roadmap' ? 'Roadmap / prévu' : 'Vision future'}</span>}
        </div>
        {section.description && <p>{section.description}</p>}
        {section.items && section.items.length > 0 && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
      </section>
    ))}
    {project.specifications && project.specifications.length > 0 && (
      <section class="project-section" aria-labelledby="specifications-title">
        <h2 id="specifications-title">Exemples de spécifications</h2>
        <div class="specification-list">
          {project.specifications.map((specification) => <article><h3>{specification.title}</h3><p>{specification.description}</p></article>)}
        </div>
      </section>
    )}
    {project.technologyWatch && project.technologyWatch.length > 0 && (
      <section class="project-section" aria-labelledby="technology-watch-title">
        <h2 id="technology-watch-title">Veille technologique</h2>
        <ul>{project.technologyWatch.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}
    {project.challenge && (
      <section class="project-section" aria-labelledby="challenge-title">
        <h2 id="challenge-title">Challenge principal</h2>
        <p>{project.challenge}</p>
      </section>
    )}
    {project.solution && (
      <section class="project-section" aria-labelledby="solution-title">
        <h2 id="solution-title">Solution apportée</h2>
        <p>{project.solution}</p>
        {project.solutionSteps && project.solutionSteps.length > 0 && <ol class="architecture-flow" aria-label="Démarche d’optimisation">{project.solutionSteps.map((step) => <li>{step}</li>)}</ol>}
      </section>
    )}
    {project.security && project.security.length > 0 && (
      <section class="project-section" aria-labelledby="security-title">
        <h2 id="security-title">Sécurité</h2>
        <ul>{project.security.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}
    {project.results && project.results.length > 0 && (
      <section class="project-section" aria-labelledby="results-title">
        <h2 id="results-title">Résultats</h2>
        <ul>{project.results.map((result) => <li>{result}</li>)}</ul>
      </section>
    )}
    {project.roadmap && project.roadmap.length > 0 && (
      <section class="project-section roadmap-section" aria-labelledby="roadmap-title">
        <div class="section-heading">
          <h2 id="roadmap-title">Évolution de Noon</h2>
          <span class="section-status section-status-roadmap">Roadmap / prévu</span>
        </div>
        <div class="roadmap-list">
          {project.roadmap.map((step) => (
            <article class:list={['roadmap-card', `roadmap-card-${step.status}`]}>
              <p class="roadmap-version">{step.version}</p>
              <div>
                <p class="roadmap-status">{step.status === 'roadmap' ? 'Roadmap / prévu' : 'Vision future'}</p>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
                <ul>{step.items.map((item) => <li>{item}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
    {project.improvements && project.improvements.length > 0 && (
      <section class="project-section" aria-labelledby="improvements-title">
        <h2 id="improvements-title">Améliorations possibles</h2>
        <ul>{project.improvements.map((improvement) => <li>{improvement}</li>)}</ul>
      </section>
    )}

    <!-- Actions externes rendues seulement lorsqu'une destination fiable est déclarée. -->
    {(project.url || project.demoUrl || (project.resources && project.resources.length > 0)) && (
      <nav class="project-actions" aria-label={`Liens du projet ${project.name}`}>
        {project.url && <a class="project-action project-action-primary" href={project.url} target="_blank" rel="noopener noreferrer">Voir le code source de {project.name} sur GitHub ↗</a>}
        {project.demoUrl && <a class="project-action" href={project.demoUrl} target="_blank" rel="noopener noreferrer">Voir la démo de {project.name} ↗</a>}
        {project.resources?.map((resource) => <a class="project-action" href={resource.href} target={resource.download ? undefined : '_blank'} rel={resource.download ? undefined : 'noopener noreferrer'} download={resource.download ? true : undefined}>{resource.label}</a>)}
      </nav>
    )}
  </main>

  <PortfolioFooter theme="dark" />
  <PortfolioOverlays theme="dark" groups={devSkillGroups} />
  {projectImages.length > 0 && (
    <script define:vars={{ images: projectImages.map(({ src, alt }) => ({ src, alt })) }}>
      const setupDevImageDialog = () => {
        const dialog = document.querySelector('[data-dev-image-dialog]');
        const image = dialog?.querySelector('[data-dev-image-dialog-image]');
        const close = dialog?.querySelector('[data-dev-image-close]');
        if (!dialog || !image || !close || dialog.dataset.ready) return;
        dialog.dataset.ready = 'true';
        let trigger = null;

        const closeDialog = () => dialog.close();
        document.querySelectorAll('[data-dev-image-open]').forEach((button) => {
          button.addEventListener('click', () => {
            const item = images[Number(button.dataset.devImageOpen)];
            if (!item) return;
            trigger = button;
            image.src = item.src;
            image.alt = item.alt;
            dialog.showModal();
            close.focus();
          });
        });
        close.addEventListener('click', closeDialog);
        dialog.addEventListener('click', (event) => { if (event.target === dialog) closeDialog(); });
        dialog.addEventListener('close', () => trigger?.focus());
      };

      setupDevImageDialog();
      document.addEventListener('astro:page-load', setupDevImageDialog);
    </script>
  )}
</BaseLayout>

<style>
  /* Thème sombre et grille éditoriale alignés sur l'univers DEV existant. */
  :root { font-family: Inter, 'Segoe UI', sans-serif; color: #f5f5f5; background: #030908; color-scheme: dark; }
  * { box-sizing: border-box; }
  body { margin: 0; background: radial-gradient(circle at 75% 0%, rgba(0, 0, 255, .14), transparent 34rem), #030908; color: #f5f5f5; }
  .project-detail { width: min(920px, calc(100% - clamp(2rem, 5vw, 6rem))); margin: 0 auto; padding: 0 0 clamp(3rem, 8vw, 7rem); }
  .project-navigation { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0 0 clamp(3rem, 7vw, 6rem); }
  .back-link, .project-action { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: .75rem 1rem; border: 1px solid rgba(154, 245, 127, .48); border-radius: 999px; color: #9af57f; font-weight: 650; text-align: center; text-decoration: none; transition: background-color .2s ease, border-color .2s ease, color .2s ease; }
  .back-link:hover, .project-action:hover { border-color: #0000FF; background: #0000FF; color: #9af57f; }
  .back-link:focus-visible, .project-action:focus-visible { outline: 3px solid #9af57f; outline-offset: 4px; }
  .project-intro { max-width: 760px; padding-bottom: clamp(2rem, 5vw, 4rem); border-bottom: 1px solid #213d32; }
  .project-kicker { margin: 0 0 1rem; color: #9af57f; font-size: .75rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  h1, h2 { overflow-wrap: anywhere; }
  h1 { margin: 0; color: #fff; font-size: clamp(2.8rem, 8vw, 6.5rem); line-height: .92; letter-spacing: -.06em; }
  .project-description { max-width: 660px; margin: clamp(1rem, 3vw, 1.75rem) 0 0; color: rgba(245, 245, 245, .78); font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.55; }
  .project-media { margin: 0; overflow: hidden; border: 1px solid #213d32; border-radius: 20px; background: #07100d; }
  .project-image-trigger { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
  .project-image-trigger:focus-visible { outline: 3px solid #9af57f; outline-offset: -5px; }
  .project-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project-media-cover { width: min(100%, 920px); aspect-ratio: 16 / 10; margin: clamp(1.75rem, 5vw, 4rem) 0 0; }
  .project-media-cover.project-media-mobile { width: min(100%, 390px); aspect-ratio: 390 / 844; }
  .project-media-architecture { padding: clamp(1rem, 3vw, 2rem); }
  .project-media-architecture img { object-fit: contain; }
  .project-media-document img { object-position: center top; }
  .project-gallery { max-width: 920px; }
  .gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .gallery-grid .project-media { aspect-ratio: 16 / 10; }
  .gallery-grid .project-media-mobile { width: min(100%, 300px); justify-self: end; aspect-ratio: 390 / 844; }
  .gallery-grid .project-media-document { aspect-ratio: 16 / 10; }
  .project-section { max-width: 760px; padding: clamp(1.75rem, 4vw, 3rem) 0; border-bottom: 1px solid #213d32; }
  .project-section h2 { margin: 0 0 1rem; color: #9af57f; font-size: clamp(1.2rem, 2.4vw, 1.75rem); line-height: 1.05; }
  .section-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: 1rem; }
  .section-heading h2 { margin: 0; }
  .section-status { display: inline-flex; padding: .35rem .55rem; border: 1px solid currentColor; border-radius: 999px; font-size: .66rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .section-status-current { color: #9af57f; }
  .section-status-roadmap { color: #7ba6ff; }
  .section-status-vision { color: #d5b6ff; }
  .project-section p, .project-section ul, .project-section ol { margin: 0; color: rgba(245, 245, 245, .78); line-height: 1.6; }
  .project-section p + ul, .project-section p + ol { margin-top: 1rem; }
  .project-section ul:not(.tag-list) { padding-left: 1.2rem; }
  .tag-list { display: flex; flex-wrap: wrap; gap: .6rem; padding: 0; list-style: none; }
  .tag-list li { padding: .45rem .7rem; border: 1px solid rgba(154, 245, 127, .48); border-radius: 999px; color: #9af57f; font-size: .78rem; letter-spacing: .06em; }
  .architecture-flow { display: flex; flex-wrap: wrap; gap: .6rem 1.6rem; padding: 0; list-style: none; }
  .architecture-flow li { position: relative; color: #9af57f; font-weight: 650; }
  .architecture-flow li:not(:last-child)::after { position: absolute; top: 50%; right: -1.1rem; color: rgba(245, 245, 245, .65); content: '→'; transform: translateY(-50%); }
  .specification-list { display: grid; gap: 1.25rem; }
  .specification-list article { padding: 1rem; border: 1px solid #213d32; border-radius: 16px; background: rgba(7, 16, 13, .65); }
  .specification-list h3 { margin: 0 0 .5rem; color: #9af57f; font-size: 1rem; }
  .roadmap-list { display: grid; gap: 1rem; }
  .roadmap-card { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; padding: clamp(1rem, 3vw, 1.5rem); border: 1px solid #213d32; border-left-width: 4px; border-radius: 18px; background: rgba(7, 16, 13, .65); }
  .roadmap-card-roadmap { border-left-color: #7ba6ff; }
  .roadmap-card-vision { border-left-color: #d5b6ff; }
  .roadmap-version, .roadmap-status, .roadmap-card h3, .roadmap-card ul { margin: 0; }
  .roadmap-version { color: #9af57f !important; font-size: 1.1rem; font-weight: 800; letter-spacing: .06em; }
  .roadmap-status { color: #7ba6ff !important; font-size: .67rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .roadmap-card-vision .roadmap-status { color: #d5b6ff !important; }
  .roadmap-card h3 { padding-top: .2rem; color: #fff; font-size: clamp(1.1rem, 2.2vw, 1.45rem); }
  .roadmap-card h3 + p { margin-top: .65rem; }
  .roadmap-card ul { margin-top: .75rem; padding-left: 1.1rem; }
  .project-actions { display: flex; flex-wrap: wrap; gap: .75rem; padding-top: clamp(2rem, 5vw, 4rem); }
  .project-action-primary { border-color: #0000FF; background: #0000FF; color: #9af57f; }
  .project-action-primary:hover { border-color: #9af57f; background: #9af57f; color: #0000FF; }
  .dev-image-dialog { width: min(1200px, calc(100vw - 2rem)); max-width: none; height: min(900px, calc(100dvh - 2rem)); max-height: none; margin: auto; padding: clamp(1rem, 3vw, 2.5rem); overflow: visible; border: 1px solid #213d32; border-radius: 24px; background: #07100d; color: #fff; }
  .dev-image-dialog::backdrop { background: rgba(3, 9, 8, .84); backdrop-filter: blur(6px); }
  .dev-image-dialog-stage { display: grid; width: 100%; height: 100%; place-items: center; }
  .dev-image-dialog img { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }
  .dev-image-dialog-close { position: absolute; z-index: 1; top: .75rem; right: .75rem; display: grid; width: 46px; height: 46px; padding: 0; place-items: center; border: 1px solid rgba(154, 245, 127, .48); border-radius: 50%; background: #07100d; color: #9af57f; font: 300 2rem/1 Arial, sans-serif; cursor: pointer; }
  .dev-image-dialog-close:hover { border-color: #0000FF; background: #0000FF; }
  .dev-image-dialog-close:focus-visible { outline: 3px solid #9af57f; outline-offset: 3px; }
  @media (max-width: 560px) { .project-navigation { align-items: flex-start; flex-direction: column-reverse; } .project-actions { align-items: stretch; flex-direction: column; } .project-action { width: 100%; } .architecture-flow { align-items: flex-start; flex-direction: column; gap: .45rem; } .architecture-flow li:not(:last-child)::after { position: static; margin-left: .5rem; content: '↓'; } .roadmap-card { grid-template-columns: 1fr; gap: .5rem; } .gallery-grid { grid-template-columns: 1fr; } .gallery-grid .project-media-mobile { width: min(100%, 280px); justify-self: center; } .dev-image-dialog { width: calc(100vw - 1rem); height: calc(100dvh - 1rem); padding: 3.75rem 1rem 1rem; border-radius: 18px; } }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition-duration: .01ms !important; } }
</style>
