---
// Charge les données et composants nécessaires aux pages détail de projets.
import { fallbackProjects } from '../../data/creativeProjects';
import { creativeLogos } from '../../data/creativeSkills';
import ProjectMosaic from '../../components/ProjectMosaic.astro';
import ExternalVideoPlayer from '../../components/ExternalVideoPlayer.astro';
import PortfolioHeader from '../../components/PortfolioHeader.astro';
import PortfolioOverlays from '../../components/PortfolioOverlays.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Génère une route statique pour chaque slug déclaré dans les données créatives.
export function getStaticPaths() {
  return fallbackProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// Prépare le projet courant, ses vidéos et son éventuelle variante IBM.
const { project } = Astro.props;
const projectVideos = project.videos ?? (project.video ? [project.video] : []);
const isIbm = project.slug === 'ibm';
const socialImage = project.cover ?? '/projets/call-of-light/cover.jpg';
const projectStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.description,
  url: new URL(`/projets/${project.slug}`, Astro.site ?? Astro.url).href,
  image: new URL(socialImage, Astro.site ?? Astro.url).href,
  creator: { '@id': 'https://arnaudpiette.com/#person' },
  keywords: project.tags.map((tag) => tag.label).join(', '),
};
---

<!-- Page détail dans le layout partagé. -->
<BaseLayout
  title={`${project.title} — Arnaud Piette`}
  description={project.description}
  ogImage={socialImage}
  ogImageAlt={project.cover ? `Aperçu du projet ${project.title}` : 'Aperçu du portfolio d’Arnaud Piette'}
  ogType="article"
  structuredData={projectStructuredData}
>
    <PortfolioHeader mode="creative" headingLevel="p" />

    <!-- Choisit la mosaïque, le lecteur vidéo ou leur combinaison selon le projet. -->
    <main>
      <nav class="project-navigation" aria-label="Navigation du projet">
        <a class="back-link" href="/creative">← Retour aux projets CRÉA</a>
      </nav>
      {isIbm ? (
        <>
          <ProjectMosaic project={project} />
          <div class="ibm-videos">
            {projectVideos.map((video) => <ExternalVideoPlayer project={project} video={video} showInfo={false} />)}
          </div>
        </>
      ) : project.mediaType === 'video' && projectVideos.length > 0 ? (
        <>
          <ExternalVideoPlayer project={project} video={projectVideos[0]} />
          {projectVideos.length > 1 && (
            <div class="additional-videos">
              {projectVideos.slice(1).map((video) => <ExternalVideoPlayer project={project} video={video} showInfo={false} />)}
            </div>
          )}
          {project.media.length > 0 && <div class="secondary-media"><ProjectMosaic project={project} showIntro={false} /></div>}
        </>
      ) : (
        <ProjectMosaic project={project} />
      )}
    </main>

    <PortfolioOverlays theme="light" logos={creativeLogos} />
</BaseLayout>

<style>
  /* Mise en page de la page détail, navigation et comportements mobiles. */
  :root { font-family: Inter, 'Segoe UI', sans-serif; color: #0000FF; background: #fff; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  main { width: calc(100% - clamp(2rem, 5vw, 6rem)); margin: 0 auto; }
  a { color: inherit; text-decoration: none; }
  .project-navigation { display: flex; margin: 0 0 clamp(2rem, 5vw, 4rem); }
  .back-link { display: inline-flex; align-items: center; gap: .6rem; padding: .6rem .9rem; border: 1px solid #0000FF; border-radius: 999px; background: #0000FF; color: #fff; transition: color .2s ease, background .2s ease, border-color .2s ease; }
  .back-link:hover { background: #fff; color: #0000FF; }
  .back-link:active { border-color: #ff8a5b; background: #ff8a5b; color: #0000FF; }
  .back-link:focus-visible { outline: 3px solid #ff8a5b; outline-offset: 3px; }
  main { padding-top: clamp(.75rem, 1.5vw, 1.5rem); padding-bottom: clamp(2rem, 5vw, 6rem); }
  .secondary-media { margin-top: clamp(10px, 1vw, 16px); }
  .additional-videos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(10px, 1vw, 16px); margin-top: clamp(10px, 1vw, 16px); }
  .ibm-videos { display: grid; grid-template-columns: 1fr; gap: clamp(10px, 1vw, 16px); margin-top: clamp(10px, 1vw, 16px); }
  @media (max-width: 760px) { .additional-videos { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition-duration: .01ms !important; } }
</style>
