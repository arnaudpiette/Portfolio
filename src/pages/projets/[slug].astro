---
// Charge les données et composants nécessaires aux pages détail de projets.
import { fallbackProjects } from '../../data/creativeProjects';
import ProjectMosaic from '../../components/ProjectMosaic.astro';
import ExternalVideoPlayer from '../../components/ExternalVideoPlayer.astro';
import MusicPlayButton from '../../components/MusicPlayButton.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Génère une route statique pour chaque slug déclaré dans les données créatives.
export function getStaticPaths() {
  return fallbackProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// Prépare le projet courant, ses vidéos et son éventuelle variante IBM.
const { project } = Astro.props;
const projectVideos = project.videos ?? (project.video ? [project.video] : []);
const isIbm = project.slug === 'ibm';
---

<!-- Page détail dans le layout partagé, avec son menu mobile propre. -->
<BaseLayout
  title={`${project.title} — arno.piette@gmail.com`}
  description={project.description}
>
    <header>
      <a class="back-link" href="/creative"><span class="chevron" aria-hidden="true"></span>Retour</a>
      <div class="header-right">
        <a class="brand" href="/" data-astro-reload>arno.piette@gmail.com</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="project-navigation" aria-label="Ouvrir le menu">
          <span></span><span></span><span></span>
        </button>
        <nav id="project-navigation" class="site-nav" aria-label="Navigation principale">
          <a href="/creative#projects">Projets</a>
          <a href="/creative#contact">Contact</a>
        </nav>
        <MusicPlayButton theme="creative" />
      </div>
    </header>

    <!-- Choisit la mosaïque, le lecteur vidéo ou leur combinaison selon le projet. -->
    <main>
      {isIbm ? (
        <>
          <ProjectMosaic project={project} />
          <div class="ibm-videos">
            {projectVideos.map((video) => <ExternalVideoPlayer project={project} video={video} showInfo={false} />)}
          </div>
        </>
      ) : project.mediaType === 'video' && projectVideos.length > 0 ? (
        <>
          <ExternalVideoPlayer project={project} video={projectVideos[0]} />
          {projectVideos.length > 1 && (
            <div class="additional-videos">
              {projectVideos.slice(1).map((video) => <ExternalVideoPlayer project={project} video={video} showInfo={false} />)}
            </div>
          )}
          {project.media.length > 0 && <div class="secondary-media"><ProjectMosaic project={project} showIntro={false} /></div>}
        </>
      ) : (
        <ProjectMosaic project={project} />
      )}
    </main>

    <nav class="bottom-navigation" aria-label="Retour aux projets">
      <a class="back-link" href="/creative"><span class="chevron" aria-hidden="true"></span>Retour</a>
    </nav>

    <script>
      // Gère l'ouverture et la fermeture du menu mobile de la page détail.
      const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const projectNavigation = document.querySelector<HTMLElement>('#project-navigation');
      const mobileMenuQuery = window.matchMedia('(max-width: 760px)');

      const closeMenu = () => {
        menuToggle?.setAttribute('aria-expanded', 'false');
        menuToggle?.setAttribute('aria-label', 'Ouvrir le menu');
        projectNavigation?.classList.remove('is-open');
      };

      menuToggle?.addEventListener('click', () => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!isOpen));
        menuToggle.setAttribute('aria-label', isOpen ? 'Ouvrir le menu' : 'Fermer le menu');
        projectNavigation?.classList.toggle('is-open', !isOpen);
      });

      projectNavigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      mobileMenuQuery.addEventListener('change', closeMenu);
      closeMenu();
    </script>
</BaseLayout>

<style>
  /* Mise en page de la page détail, navigation et comportements mobiles. */
  :root { font-family: Inter, 'Segoe UI', sans-serif; color: #0000FF; background: #fff; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  header, main, .bottom-navigation { width: calc(100% - clamp(2rem, 5vw, 6rem)); margin: 0 auto; }
  header { position: relative; display: flex; justify-content: space-between; align-items: center; padding: 2rem 0 1.5rem; }
  a { color: inherit; text-decoration: none; }
  .back-link { display: inline-flex; align-items: center; gap: .6rem; padding: .6rem .9rem; border: 1px solid #0000FF; border-radius: 999px; background: #0000FF; color: #fff; transition: color .2s ease, background .2s ease, border-color .2s ease; }
  .back-link:hover { background: #fff; color: #0000FF; }
  .back-link:active { border-color: #ff8a5b; background: #ff8a5b; color: #0000FF; }
  .back-link:focus-visible { outline: 3px solid #ff8a5b; outline-offset: 3px; }
  .chevron { width: 10px; height: 10px; border-left: 2px solid currentColor; border-bottom: 2px solid currentColor; border-radius: 1.5px; transform: rotate(45deg); }
  .brand { color: #9b9691; font-size: 1rem; font-weight: 500; }
  .header-right, .site-nav { display: flex; align-items: center; }
  .header-right { gap: 1.25rem; }
  .site-nav { gap: 1rem; }
  .site-nav a { display: inline-flex; align-items: center; justify-content: center; width: 112px; height: 42px; color: #0000FF; padding: 0; border: 1px solid rgba(0, 0, 255, .16); border-radius: 999px; text-decoration: none; }
  .site-nav a:focus-visible { outline: 3px solid #ff8a5b; outline-offset: 3px; }
  .menu-toggle { position: relative; display: none !important; flex: 0 0 42px; width: 42px; height: 42px; padding: 0; appearance: none; border: 1px solid rgba(0, 0, 255, .16); border-radius: 50%; background: #fff; cursor: pointer; }
  .menu-toggle span { position: absolute; right: 10px; left: 10px; display: block; height: 2px; margin: 0; border-radius: 2px; background: #0000FF; transition: top .2s ease, transform .2s ease, opacity .2s ease; }
  .menu-toggle span:nth-child(1) { top: 12px; }
  .menu-toggle span:nth-child(2) { top: 19px; }
  .menu-toggle span:nth-child(3) { top: 26px; }
  main { padding-top: clamp(.75rem, 1.5vw, 1.5rem); padding-bottom: clamp(2rem, 5vw, 6rem); }
  .bottom-navigation { display: flex; justify-content: flex-start; padding-bottom: clamp(2rem, 5vw, 5rem); }
  .secondary-media { margin-top: clamp(10px, 1vw, 16px); }
  .additional-videos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(10px, 1vw, 16px); margin-top: clamp(10px, 1vw, 16px); }
  .ibm-videos { display: grid; grid-template-columns: 1fr; gap: clamp(10px, 1vw, 16px); margin-top: clamp(10px, 1vw, 16px); }
  @media (max-width: 760px) {
    .additional-videos { grid-template-columns: 1fr; }
    .header-right { gap: .75rem; padding-right: 58px; }
    .header-right > :global(.music-player-control) { position: absolute; top: 2rem; right: 0; }
    .menu-toggle { display: inline-block !important; }
    .site-nav { position: absolute; z-index: 10; top: calc(100% - .75rem); right: 0; display: none; min-width: 190px; align-items: stretch; flex-direction: column; gap: .6rem; padding: .8rem; border: 1px solid rgba(0, 0, 255, .12); border-radius: 20px; background: #fff; box-shadow: 0 16px 40px rgba(0, 0, 255, .12); }
    .site-nav.is-open { display: flex; }
    .site-nav a { text-align: center; }
    .menu-toggle[aria-expanded='true'] span:nth-child(1) { top: 19px; transform: rotate(45deg); }
    .menu-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
    .menu-toggle[aria-expanded='true'] span:nth-child(3) { top: 19px; transform: rotate(-45deg); }
  }
  @media (max-width: 560px) { .brand { font-size: .67rem; } }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition-duration: .01ms !important; } }
</style>
