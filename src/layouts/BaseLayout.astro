---
import { ClientRouter } from 'astro:transitions';
import '../styles/page-transitions.css';

// Décrit les métadonnées reçues de chaque page qui utilise ce layout.
interface Props {
  title: string;
  description?: string;
  pageTransition?: 'home' | 'creative' | 'dev';
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = '',
  pageTransition,
  ogImage,
  ogImageAlt = '',
  ogType = 'website',
  structuredData,
} = Astro.props;

const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalURL = new URL(canonicalPath, Astro.site ?? Astro.url);
const socialImageURL = ogImage ? new URL(ogImage, canonicalURL).href : undefined;
---

<!-- Squelette HTML partagé par les pages principales du portfolio. -->
<html lang="fr">
  <head>
    <!-- Métadonnées techniques et icônes communes à toutes les pages. -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta name="generator" content={Astro.generator} />

    <!-- Titre et description SEO fournis par la page courante. -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    {description && (
      <meta name="description" content={description} />
    )}

    <!-- Métadonnées Open Graph textuelles partagées par les pages du portfolio. -->
    <meta property="og:title" content={title} />
    {description && (
      <meta property="og:description" content={description} />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    {socialImageURL && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    {socialImageURL && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <!-- Active les transitions Astro entre les pages utilisant ce layout. -->
    <ClientRouter fallback="swap" />

    <slot name="head" />
  </head>

  <body data-portfolio-page={pageTransition}>
    <!-- Emplacement du contenu propre à chaque page. -->
    <slot />
    <!-- Ajoute l'entrée CSS de secours après chaque chargement ou swap Astro. -->
    <script>
      import '../scripts/pageTransitions.js';
    </script>
  </body>
</html>
